# Backend API Configuration for LattiumHR / Neuverve Marketing Website

# Optional: Override the exact enquiry API URL
# VITE_ENQUIRY_API_URL=https://api.yourdomain.com/neuverve/public/enquiry

# Optional: Base domain (endpoint will append /neuverve/public/enquiry automatically)
# VITE_API_BASE_URL=https://api.yourdomain.com

# Default fallback if not set: http://localhost:5000/neuverve/public/enquiry

