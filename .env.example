# Backend CRM API Configuration for Zentilos Marketing Website
# Default target endpoint for all form submissions:
VITE_API_BASE_URL=http://192.168.1.5:5173/neuverve/
VITE_CRM_API_URL=http://192.168.1.5:5173/neuverve/
VITE_ENQUIRY_API_URL=http://192.168.1.5:5173/neuverve/

# Search engine indexing control ("index, follow" for production, "noindex, nofollow" for dev/staging)
VITE_ROBOTS="noindex, nofollow"

# Canonical site base URL for Schema.org JSON-LD and OpenGraph metadata (no trailing slash)
VITE_SITE_URL=http://localhost:5173
