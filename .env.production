# Production Deployment Environment
# Vite automatically loads this during `npm run build`
# Set this to your live CRM backend domain:
# Example: VITE_API_BASE_URL=https://api.zentilos.com
# Or leave unset to default to relative path /api/platform/enquiries/public
VITE_API_BASE_URL=
VITE_ROBOTS="index, follow"

# Canonical site base URL for Schema.org JSON-LD and OpenGraph metadata (no trailing slash)
# Set your production domain when purchased (e.g. https://your-domain.com).
# When unset or empty, falls back to http://localhost:5173
VITE_SITE_URL=
